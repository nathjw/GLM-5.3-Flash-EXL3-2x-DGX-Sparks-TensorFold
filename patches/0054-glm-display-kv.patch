+"""Recipe policy for one complete FP8 latent plane in external display storage.
+
+The generic DRM/CUDA allocator lives in tensorfold.cuda.display_memory. All GLM
+layout, layer selection and pool sizing policy stays in this recipe patch.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import os
+
+ALIGN = 2048
+DRM_ALIGNMENT = 65536
+
+
+@dataclass(frozen=True)
+class Settings:
+    enabled: bool = False
+    layer: int = -1
+    max_bytes: int = 1792 << 20
+    card: str = '/dev/dri/card0'
+    pool_tokens: int = 0
+
+    @classmethod
+    def from_env(cls, env=None):
+        env = os.environ if env is None else env
+        on = env.get('TF_GLM_DISPLAY_KV', '0')
+        if on not in ('0', '1'):
+            raise ValueError('TF_GLM_DISPLAY_KV must be 0 or 1')
+        pool = int(env.get('TF_GLM_KV_POOL_TOKENS', '0'))
+        if pool < 0 or pool % ALIGN:
+            raise ValueError('TF_GLM_KV_POOL_TOKENS must be zero (auto) or a positive multiple of 2048')
+        if on == '0':
+            return cls(pool_tokens=pool)
+        layer = int(env.get('TF_GLM_DISPLAY_KV_PLANE', '-1'))
+        mib = int(env.get('TF_GLM_DISPLAY_KV_MIB', '1792'))
+        card = env.get('TF_GLM_DISPLAY_KV_CARD', '/dev/dri/card0')
+        if layer < 0:
+            raise ValueError('set TF_GLM_DISPLAY_KV_PLANE to the zero-based model layer (e.g. 3), not DSA ordinal')
+        if not 1 <= mib <= 1792:
+            raise ValueError('TF_GLM_DISPLAY_KV_MIB must be between 1 and the qualified ceiling of 1792')
+        if not card.startswith('/dev/dri/card') or not card[len('/dev/dri/card'):].isdigit():
+            raise ValueError('TF_GLM_DISPLAY_KV_CARD must be /dev/dri/cardN')
+        return cls(True, layer, mib << 20, card, pool)
+
+    def validate(self, cfg, *, parallel, latent, kv):
+        if (self.enabled or self.pool_tokens) and parallel < 2:
+            raise ValueError('Display-KV and fixed pool sizing require --parallel 2..4 (one request still works)')
+        if not self.enabled:
+            return
+        if not latent or kv != 'fp8':
+            raise ValueError('Display-KV currently requires TF_GLM_LATENT=1 and TF_GLM_KV=fp8')
+        if self.layer >= len(cfg.kinds) or cfg.kinds[self.layer] != 'dsa':
+            raise ValueError(f'Display-KV layer {self.layer} is not a DSA layer')
+        if cfg.kv_lora % 16:
+            raise ValueError('Display-KV needs a latent width divisible by 16')
+
+    def code(self):
+        # Card paths may differ between hosts. Placement, size and pool must agree on both ranks.
+        return [int(self.enabled), self.layer, self.max_bytes >> 20, self.pool_tokens]
+
+    def row_bytes(self, width):
+        return width + 16 if self.enabled else 0
+
+    def max_rows(self, width):
+        return self.max_bytes // (width + 16) // ALIGN * ALIGN
+
+    def offloaded(self, rows, width):
+        # Clamped for the capacity estimator's probes; actual allocation requires the WHOLE plane.
+        return min(rows, self.max_rows(width)) * self.row_bytes(width)
+
+    def allocate(self, rows, width, device='cuda'):
+        if not self.enabled:
+            return None
+        from tensorfold.cuda.display_memory import zeros
+        import torch
+
+        if rows > self.max_rows(width):
+            raise ValueError(f'Display-KV plane needs {rows * (width + 16)} bytes, ceiling {self.max_bytes}')
+        storage = zeros((rows, width + 16), dtype=torch.uint8, device=device, card=self.card, max_bytes=self.max_bytes)
+        storage.receipt['layer'] = self.layer
+        return storage
+
+
+def pool_rows(settings, *, capacity, automatic, width, growth_bytes, allowance):
+    """Choose a whole pool that fits BOTH ordinary memory and one complete external plane.
+
+    ``growth_bytes(rows)`` includes fixed retained states and every cache/workspace change
+    from the startup context. A forced pool never silently shrinks or exceeds its budget.
+    """
+    minimum = (capacity + ALIGN - 1) // ALIGN * ALIGN
+    ceiling = settings.max_rows(width) if settings.enabled else automatic
+    if settings.pool_tokens:
+        chosen = settings.pool_tokens
+        if chosen < minimum:
+            raise ValueError(f'fixed KV pool {chosen} cannot hold context plus reserve ({minimum} rows)')
+        if settings.enabled and chosen > ceiling:
+            raise ValueError(f'fixed KV pool {chosen} exceeds display plane capacity {ceiling}')
+        if growth_bytes(chosen) > allowance:
+            raise ValueError(f'fixed KV pool {chosen} needs more ordinary memory than its budget; lower pool/context')
+        return chosen
+    ceiling = min(automatic, ceiling)
+    if ceiling < minimum or growth_bytes(minimum) > allowance:
+        raise ValueError('Display-KV pool cannot hold context, reserve and retained states within both budgets')
+    lo, hi = minimum // ALIGN, ceiling // ALIGN
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if growth_bytes(mid * ALIGN) <= allowance:
+            lo = mid
+        else:
+            hi = mid - 1
+    return lo * ALIGN
